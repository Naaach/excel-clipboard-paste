{
  "name": "excel-clipboard-paste",
  "version": "0.1.1",
  "description": "Parse clipboard data pasted from Excel or Google Sheets into a clean matrix. Zero dependencies, TypeScript, ESM + CJS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "excel",
    "google-sheets",
    "spreadsheet",
    "clipboard",
    "paste",
    "onpaste",
    "tsv",
    "csv",
    "parser",
    "matrix",
    "table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naaach/excel-clipboard-paste.git"
  },
  "homepage": "https://github.com/Naaach/excel-clipboard-paste#readme",
  "bugs": "https://github.com/Naaach/excel-clipboard-paste/issues",
  "author": {
    "name": "Naaach",
    "url": "https://github.com/Naaach"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "gif": "node scripts/make-gif.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
